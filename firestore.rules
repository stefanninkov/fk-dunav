rules_version = '2';

// ------------------------------------------------------------------
// Firestore rules — Phase 1 starter.
//
// Default posture: DENY ALL. Real rules per-collection land in Phase 2
// and beyond, following docs/SECURITY-RULES.md.
//
// The only exception is /adminEmails, which is read by the magic-link
// Cloud Function to look up Stefan's hardcoded bootstrap email on
// first sign-in. No client ever reads or writes this collection.
// ------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers.
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // Bootstrap: seeded manually via Firebase console before first deploy.
    //
    // Any signed-in user can read this collection so the client can self-
    // promote to admin on the Spark plan (no Cloud Functions needed). The
    // list is tiny and not sensitive — knowing who the admins are is fine.
    // Writes remain denied so the seed can only be edited from the console.
    match /adminEmails/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny-all fallback. Every collection gets an explicit rule in later
    // phases; until then nothing else is accessible from the client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
