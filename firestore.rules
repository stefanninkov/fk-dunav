rules_version = '2';

// ------------------------------------------------------------------
// Firestore rules — TOURNAMENT-DAY OPEN MODE.
//
// For the 2026 edition the admin panel is publicly reachable: anyone
// with the URL gets an anonymous Firebase Auth session and can write
// to the tournament collections. The strict capability-based model
// (admins / staff invites / caps array) is preserved for /adminEmails,
// /admins, /users and /invites — those still require an authenticated
// admin since they control durable role state — but the per-tournament
// collections relax to `isSignedIn()` (anonymous included).
//
// To tighten back after the tournament: swap each `isSignedIn()` write
// rule below for the original `hasCap(<cap>)` check (see git history).
// ------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function inviteCapsForCaller() {
      return get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.caps;
    }

    // ------------------------------------------------------------
    // /adminEmails — bootstrap seed (doc id must equal the email).
    // ------------------------------------------------------------
    match /adminEmails/{email} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ------------------------------------------------------------
    // /admins/{uid} — role cache written by client on self-promotion.
    // Anonymous users can never become admin; this rule still requires
    // a real email matching /adminEmails.
    // ------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
                     && request.auth.uid == uid
                     && request.auth.token.email != null
                     && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
                     && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------
    // /users — staff docs. Strict per the capability model — anonymous
    // sessions can't grant themselves caps via this collection.
    // ------------------------------------------------------------
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn()
                     && request.auth.uid == uid
                     && request.auth.token.email != null
                     && request.resource.data.email == request.auth.token.email
                     && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
                     && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.revoked == false
                     && request.resource.data.caps.hasAll(inviteCapsForCaller())
                     && request.resource.data.caps.hasOnly(inviteCapsForCaller());
      allow update: if isAdmin()
                     || (isSignedIn()
                         && request.auth.uid == uid
                         && request.resource.data.caps == resource.data.caps);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // /invites — admin only (so the strict caps trail is preserved).
    // ------------------------------------------------------------
    match /invites/{email} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------
    // /tournaments — settings stay admin-only; per-tournament data
    // opens up to any signed-in session for the tournament-day window.
    // ------------------------------------------------------------
    match /tournaments/{tid} {
      allow read: if resource.data.status != 'draft' || isAdmin();
      allow list: if true;
      allow create, update: if isAdmin();
      allow delete: if false;

      match /groups/{gid}              { allow read: if true; allow write: if isSignedIn(); }
      match /groupDrawSession/{sid}    { allow read: if true; allow write: if isSignedIn(); }
      match /teams/{teamId}            { allow read: if true; allow write: if isSignedIn(); }
      match /players/{playerId}        { allow read: if true; allow write: if isSignedIn(); }

      match /matches/{matchId} {
        allow read: if true;
        allow write: if isSignedIn();

        match /events/{eventId} {
          allow read: if true;
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if isSignedIn();
        }
      }

      match /standings/{teamId} {
        allow read: if true;
        // Standings are recomputed by the Cloud Function (Admin SDK
        // bypasses rules). Admin manual fix as fallback.
        allow write: if isAdmin();
      }

      match /photos/{photoId} {
        // Public sees approved only; staff see everything for moderation.
        allow read: if (resource != null && resource.data.status == 'approved')
                     || isSignedIn();
        // Anonymous submissions still go through createPhotoRecord
        // (IP rate limit). Direct client creates remain disallowed.
        allow create: if isAdmin();
        allow update, delete: if isSignedIn();
      }

      match /announcements/{id} { allow read: if true; allow write: if isSignedIn(); }
      match /sponsors/{id}      { allow read: if true; allow write: if isSignedIn(); }
      match /kupSanka/{id}      { allow read: if true; allow write: if isSignedIn(); }
      match /crossbar/{pid}     { allow read: if true; allow write: if isSignedIn(); }
      match /awards/{awardId}   { allow read: if true; allow write: if isSignedIn(); }
      match /lottery/{prizeId}  { allow read: if true; allow write: if isSignedIn(); }
      match /lotteryParticipants/{pid} { allow read: if true; allow write: if isSignedIn(); }
      match /lotterySession/{sid}      { allow read: if true; allow write: if isSignedIn(); }
      match /content/{pageId}   { allow read: if true; allow write: if isSignedIn(); }

      match /fanVotes/{pollId} {
        allow read: if true;
        allow create, update: if isSignedIn()
          || (request.resource.data.keys().hasAll(['candidates'])
              && resource != null
              && resource.data.status == 'open');
        allow delete: if isSignedIn();

        match /votes/{deviceId} {
          allow read: if false;
          allow create: if get(/databases/$(database)/documents/tournaments/$(tid)/fanVotes/$(pollId)).data.status == 'open';
          allow update, delete: if false;
        }
      }
    }

    // ------------------------------------------------------------
    // /champions — historical winners. Admin only.
    // ------------------------------------------------------------
    match /champions/{year} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // /photoRateLimits — function-only.
    match /photoRateLimits/{ipHash} {
      allow read, write: if false;
    }

    // Anonymous push subscriptions — id is the FCM registration token.
    match /pushSubscriptions/{token} {
      allow read: if false;
      allow create, update: if request.resource.data.token == token;
      allow delete: if false;
    }

    // Deny-all fallback.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
