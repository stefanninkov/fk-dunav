rules_version = '2';

// ------------------------------------------------------------------
// Firestore rules — Phase 2 (data layer). Re-deploy trigger.
//
// Core invariants:
//  - Public can read active/archived tournaments and all their child
//    collections. Draft tournaments are admin-only.
//  - Reporters can write matches + players. Admins do everything else.
//  - /adminEmails is readable by signed-in users (so AppRoot can self-
//    promote on the Spark plan). Non-writable from the client.
//  - /admins/{uid} is the authoritative role cache: the client writes
//    it once, at sign-in, only if its own email appears in /adminEmails
//    under a doc whose id is the user's email. Every other collection
//    checks isAdmin() against that doc.
//  - Everything not explicitly allowed is denied.
//
// Seed prerequisites:
//  - /adminEmails must contain one doc with id === the admin's email,
//    e.g. /adminEmails/stefan.ninkov@gmail.com with field email:"stefan.ninkov@gmail.com".
// ------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasClaim(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    // Admin custom claim (future Cloud Function path) OR an /admins/{uid}
    // doc that was seeded on first sign-in.
    function isAdmin() {
      return hasClaim('admin')
             || (isSignedIn()
                 && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isReporterOrAdmin() {
      return hasClaim('reporter') || isAdmin();
    }

    // ------------------------------------------------------------
    // /adminEmails — bootstrap seed (doc id must equal the email).
    // ------------------------------------------------------------
    match /adminEmails/{email} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ------------------------------------------------------------
    // /admins/{uid} — role cache written by client on self-promotion.
    // Allowed to create only if the caller's email has a matching doc
    // in /adminEmails (doc id = email). Updates and deletes are closed.
    // ------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
                     && request.auth.uid == uid
                     && request.auth.token.email != null
                     && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
                     && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------
    // /users — profile docs
    // ------------------------------------------------------------
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ------------------------------------------------------------
    // /invites — reporter / admin invites by email (doc id = email)
    // ------------------------------------------------------------
    match /invites/{email} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------
    // /tournaments
    // ------------------------------------------------------------
    match /tournaments/{tid} {
      allow read: if resource.data.status != 'draft' || isAdmin();
      // Listing (e.g. /admin/turnir) must be allowed for admins too.
      // Firestore evaluates list rules per-doc; drafts will still be
      // denied to non-admins.
      allow list: if true;
      allow create, update: if isAdmin();
      allow delete: if false;

      match /groups/{gid} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /teams/{teamId} {
        allow read: if true;
        allow create, update: if isReporterOrAdmin();
        allow delete: if false;
      }

      match /players/{playerId} {
        allow read: if true;
        allow create, update: if isReporterOrAdmin();
        allow delete: if false;
      }

      match /matches/{matchId} {
        allow read: if true;
        allow write: if isReporterOrAdmin();

        match /events/{eventId} {
          allow read: if true;
          allow create: if isReporterOrAdmin();
          allow update, delete: if isAdmin();
        }
      }

      match /standings/{teamId} {
        allow read: if true;
        allow write: if isAdmin(); // until Cloud Function takes over
      }

      match /photos/{photoId} {
        // Public sees approved only; admins see everything (incl. pending).
        allow read: if (resource != null && resource.data.status == 'approved') || isAdmin();
        // Anyone can create a pending submission as long as status is
        // 'pending' and takedownRequested is false. Admins alone can
        // move it to approved/rejected or otherwise mutate.
        allow create: if request.resource.data.status == 'pending'
                      && request.resource.data.takedownRequested == false;
        allow update, delete: if isAdmin();
      }
      match /announcements/{id} { allow read: if true; allow write: if isAdmin(); }
      match /sponsors/{id}      { allow read: if true; allow write: if isAdmin(); }
      match /kupSanka/{teamId}  { allow read: if true; allow write: if isReporterOrAdmin(); }
      match /crossbar/{pid}     { allow read: if true; allow write: if isAdmin(); }
      match /awards/{awardId}   { allow read: if true; allow write: if isAdmin(); }
      match /lottery/{prizeId}  { allow read: if true; allow write: if isAdmin(); }
      match /lotteryParticipants/{pid} { allow read: if true; allow write: if isAdmin(); }
      match /content/{pageId}   { allow read: if true; allow write: if isAdmin(); }
      match /fanVotes/{pollId} {
        allow read: if true;
        // Admins curate the poll + candidates. Public writes (vote count
        // denormalized on the poll doc) are allowed when a vote subdoc is
        // simultaneously created — the batched write covers both.
        allow create, update: if isAdmin()
          || (request.resource.data.keys().hasAll(['candidates'])
              && resource != null
              && resource.data.status == 'open');
        allow delete: if isAdmin();

        match /votes/{deviceId} {
          allow read: if false;
          // Anyone can create their own vote once; doc id = deviceId so a
          // duplicate vote from the same device is rejected by the
          // "create-only" rule (update/delete closed).
          allow create: if get(/databases/$(database)/documents/tournaments/$(tid)/fanVotes/$(pollId)).data.status == 'open';
          allow update, delete: if false;
        }
      }
    }

    // ------------------------------------------------------------
    // /champions — historical tournament winners (top-level). Public
    // read, admin write. Doc id = year (e.g. '2025').
    // ------------------------------------------------------------
    match /champions/{year} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // /photoRateLimits — per-IP-hash submission bucket written only by the
    // createPhotoRecord Cloud Function via Admin SDK. No client access.
    match /photoRateLimits/{ipHash} {
      allow read, write: if false;
    }

    // Anonymous push subscriptions — id is the FCM registration token.
    // Any visitor can create/update their own subscription (no auth
    // required, rate-limited by App Check in practice). Reads are only
    // for Cloud Functions via the Admin SDK; clients never list this.
    match /pushSubscriptions/{token} {
      allow read: if false;
      allow create, update: if request.resource.data.token == token;
      allow delete: if false;
    }

    // Deny-all fallback.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
