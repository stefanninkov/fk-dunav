rules_version = '2';

// ------------------------------------------------------------------
// Firestore rules — capability-based access.
//
// Admins (emails in /adminEmails) hold every capability. Everyone else
// gets what the admin granted via /invites → /users/{uid}.caps. Each
// protected collection checks the specific capability it needs.
//
// Capabilities: matches, teams, photos, side_events, content.
//
// Seed prerequisites:
//  - /adminEmails must contain one doc with id === the admin's email,
//    e.g. /adminEmails/stefan.ninkov@gmail.com with field
//    email:"stefan.ninkov@gmail.com".
// ------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function userCaps() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.caps;
    }

    function hasCap(cap) {
      return isAdmin()
             || (isSignedIn()
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && cap in userCaps());
    }

    function inviteCapsForCaller() {
      return get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.caps;
    }

    // ------------------------------------------------------------
    // /adminEmails — bootstrap seed (doc id must equal the email).
    // ------------------------------------------------------------
    match /adminEmails/{email} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ------------------------------------------------------------
    // /admins/{uid} — role cache written by client on self-promotion.
    // ------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
                     && request.auth.uid == uid
                     && request.auth.token.email != null
                     && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
                     && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------
    // /users — staff docs. Admin read/write any; a caller may read
    // their own doc and may self-promote ONCE using the invite caps.
    // ------------------------------------------------------------
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      // First-time consumption: caller writes /users/{own uid} with caps
      // that exactly match their active invite's caps. Email must match
      // the auth token. Invite must not be revoked.
      allow create: if isSignedIn()
                     && request.auth.uid == uid
                     && request.auth.token.email != null
                     && request.resource.data.email == request.auth.token.email
                     && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
                     && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.revoked == false
                     && request.resource.data.caps.hasAll(inviteCapsForCaller())
                     && request.resource.data.caps.hasOnly(inviteCapsForCaller());

      allow update: if isAdmin()
                     // Or the user updating their own last-login / profile
                     // data without escalating caps (admin is the only one
                     // who can change caps on an existing doc).
                     || (isSignedIn()
                         && request.auth.uid == uid
                         && request.resource.data.caps == resource.data.caps);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // /invites — capability grants keyed by email (doc id = email)
    // ------------------------------------------------------------
    match /invites/{email} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------
    // /tournaments
    // ------------------------------------------------------------
    match /tournaments/{tid} {
      allow read: if resource.data.status != 'draft' || isAdmin();
      allow list: if true;
      allow create, update: if isAdmin();
      allow delete: if false;

      match /groups/{gid} {
        allow read: if true;
        allow write: if hasCap('teams');
      }

      match /groupDrawSession/{sid} {
        allow read: if true;
        allow write: if hasCap('teams');
      }

      match /teams/{teamId} {
        allow read: if true;
        allow write: if hasCap('teams');
      }

      match /players/{playerId} {
        allow read: if true;
        allow write: if hasCap('teams');
      }

      match /matches/{matchId} {
        allow read: if true;
        allow write: if hasCap('matches');

        match /events/{eventId} {
          allow read: if true;
          allow create: if hasCap('matches');
          // Reporters can soft-delete their OWN events (typo recovery)
          // — only the deleted/deletedAt/deletedBy fields may change.
          allow update: if isAdmin()
            || (hasCap('matches')
                && resource.data.createdBy == request.auth.uid
                && request.resource.data.diff(resource.data).changedKeys()
                     .hasOnly(['deleted', 'deletedAt', 'deletedBy']));
          allow delete: if isAdmin();
        }
      }

      match /standings/{teamId} {
        allow read: if true;
        // Cloud Function via Admin SDK bypasses rules; keep admin fallback
        // for the rare manual fix.
        allow write: if isAdmin();
      }

      match /photos/{photoId} {
        // Public sees approved only; staff with the photos cap see
        // everything so they can moderate pending submissions.
        allow read: if (resource != null && resource.data.status == 'approved')
                     || hasCap('photos');
        // Anonymous submissions go through the createPhotoRecord Cloud
        // Function (rate-limited, writes as admin). Direct client creates
        // remain disallowed.
        allow create: if isAdmin();
        allow update, delete: if hasCap('photos');
      }

      match /announcements/{id} { allow read: if true; allow write: if hasCap('content'); }
      match /sponsors/{id}      { allow read: if true; allow write: if hasCap('content'); }
      match /kupSanka/{id}      { allow read: if true; allow write: if hasCap('side_events'); }
      match /crossbar/{pid}     { allow read: if true; allow write: if hasCap('side_events'); }
      match /awards/{awardId}   { allow read: if true; allow write: if hasCap('side_events'); }
      match /lottery/{prizeId}  { allow read: if true; allow write: if hasCap('side_events'); }
      match /lotteryParticipants/{pid} { allow read: if true; allow write: if hasCap('side_events'); }
      match /lotterySession/{sid}      { allow read: if true; allow write: if hasCap('side_events'); }
      match /content/{pageId}   { allow read: if true; allow write: if hasCap('content'); }

      match /fanVotes/{pollId} {
        allow read: if true;
        // Content cap curates the poll. Public writes (vote count
        // denormalized on the poll doc) are allowed on an open poll.
        allow create, update: if hasCap('content')
          || (request.resource.data.keys().hasAll(['candidates'])
              && resource != null
              && resource.data.status == 'open');
        allow delete: if hasCap('content');

        match /votes/{deviceId} {
          allow read: if false;
          allow create: if get(/databases/$(database)/documents/tournaments/$(tid)/fanVotes/$(pollId)).data.status == 'open';
          allow update, delete: if false;
        }
      }
    }

    // ------------------------------------------------------------
    // /champions — historical tournament winners (top-level).
    // ------------------------------------------------------------
    match /champions/{year} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // /photoRateLimits — per-IP-hash bucket written only by the
    // createPhotoRecord Cloud Function via Admin SDK. No client access.
    match /photoRateLimits/{ipHash} {
      allow read, write: if false;
    }

    // Anonymous push subscriptions — id is the FCM registration token.
    match /pushSubscriptions/{token} {
      allow read: if false;
      allow create, update: if request.resource.data.token == token;
      allow delete: if false;
    }

    // Deny-all fallback.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
