# Firebase web config for the fk-dunav project.
# These values are not secrets — Firebase JS SDK config is designed to be
# shipped to browsers. Access is gated by Firestore/Storage security rules,
# Firebase Auth authorized domains, and App Check. Override per environment
# in .env.local (gitignored).
VITE_FIREBASE_API_KEY=AIzaSyCNQYZh7kiaHk1PmSqZC6y-VkZ0lw8KpkU
VITE_FIREBASE_AUTH_DOMAIN=fk-dunav.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fk-dunav
VITE_FIREBASE_STORAGE_BUCKET=fk-dunav.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=314975519694
VITE_FIREBASE_APP_ID=1:314975519694:web:29206f8f608ab8c942219f
VITE_FIREBASE_MEASUREMENT_ID=G-58BPCRXWW6

# VAPID public key for Web Push. Generate in Firebase console →
# Project settings → Cloud Messaging → Web Push certificates. Safe to
# commit — the matching private key stays server-side.
VITE_FIREBASE_VAPID_KEY=BCYXryMydV66ZZrOnv5dGVSpx-_DBcKQwsdXjLt5UnJ4zk0dhQ9kKraUdEppIrhL7lHPdv3Cu5Hhd2wpADsQCPE

# Switch to `true` when running `firebase emulators:start` locally. Leave
# empty / `false` to talk to the real Firebase project.
VITE_USE_FIREBASE_EMULATORS=false
