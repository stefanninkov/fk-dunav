{
  "name": "fk-dunav-tournament",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "FK Dunav Ostrovo tournament platform — live scores, gallery, side competitions. 2026 edition.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test:rules": "firebase emulators:exec --only firestore --project demo-fk-dunav \"npm exec vitest -- run tests/rules\"",
    "deploy:gh": "npm run build && gh-pages -d dist -b gh-pages"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.18",
    "@fontsource/space-grotesk": "^5.0.19",
    "@hookform/resolvers": "^3.9.0",
    "@sentry/react": "^10.49.0",
    "firebase": "^10.13.0",
    "gsap": "^3.12.5",
    "lucide-react": "^0.441.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@sentry/vite-plugin": "^5.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "gh-pages": "^6.1.1",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^4.1.5"
  }
}
